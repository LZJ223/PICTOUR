[sub_resource type="Resource" id="Resource_bbxq7"]
script = ExtResource("2_tgbom")
text = "很久很久以前，森林里有一个小机器人。他听说云端有珍贵的宝藏，于是踏上了冒险的旅途......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_cb7gd"]
script = ExtResource("2_tgbom")
speaker = 2
text = "谁？谁在说话？"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_237ks"]
script = ExtResource("2_tgbom")
speaker = 1
text = "你好啊，小机器人！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_np0hi"]
script = ExtResource("2_tgbom")
speaker = 2
text = "你...你又是什么东西？"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_gudli"]
script = ExtResource("2_tgbom")
speaker = 1
text = "别这么说嘛，我会伤心的......开玩笑的。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_dbj7n"]
script = ExtResource("2_tgbom")
speaker = 1
text = "我是这个世界的化身，你可以叫我绘本精灵。而你就是这个绘本的主角！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_8my31"]
script = ExtResource("2_tgbom")
speaker = 1
text = "作为主角，当然有不可一世的能力啦！按下 W A S D 移动，按下 Space 跳跃，按下 F 唤出无人机，按住 Shift 可以预览目的地哦。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_tgbom"]
script = ExtResource("2_tgbom")
speaker = 2
text = "叽里咕噜说什么呢......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_jxlpv"]
script = ExtResource("2_tgbom")
speaker = 1
text = "还有还有，按 左键 可以选中物体，按下 Q E 可以在选中物体时切换物体的图层，没有选中物体时可以切换自己的图层，快去试试吧！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_2uycx"]
script = ExtResource("2_tgbom")
speaker = 2
text = "图层......是个什么东西......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

