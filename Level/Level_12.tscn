[sub_resource type="Resource" id="Resource_bbs3t"]
script = ExtResource("2_cav3p")
text = "最后，小机器人爬到了遥远的云端，这里有圆圆的月亮。他看到了这样的景色，忽然明白了自己一直在寻找的宝藏是什么......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_svnbj"]
script = ExtResource("2_cav3p")
speaker = 1
text = "所以是什么？"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_ggsb1"]
script = ExtResource("2_cav3p")
speaker = 2
text = "。。。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_1dlip"]
script = ExtResource("2_cav3p")
speaker = 1
text = "我想我们该说再见了。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_0uhoc"]
script = ExtResource("2_cav3p")
speaker = 2
text = "是啊......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_p1smg"]
script = ExtResource("2_cav3p")
text = "这就是今天全部的故事了。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_dmi4s"]
script = ExtResource("2_cav3p")
text = "晚安。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

