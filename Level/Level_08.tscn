[sub_resource type="Resource" id="Resource_bj315"]
script = ExtResource("2_83wbu")
speaker = 1
text = "天要黑了！[color=#1B5E20]你的那些朋友们也都回来了[/color]！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_ab0gm"]
script = ExtResource("2_83wbu")
speaker = 2
text = "据我所知，他们只负责白天树林里的巡逻......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_y3u0n"]
script = ExtResource("2_83wbu")
speaker = 1
text = "反正都要往上爬，[color=#1B5E20]也许可以让他们带你一程呢[/color]！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_6g6uo"]
script = ExtResource("2_83wbu")
speaker = 2
text = "正在下载及版本兼容语言模块......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_sy1uu"]
script = ExtResource("2_83wbu")
speaker = 1
text = "我开玩笑的！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_645n3"]
script = ExtResource("2_83wbu")
speaker = 2
text = "我也是。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

