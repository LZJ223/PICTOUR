[sub_resource type="Resource" id="Resource_55i33"]
script = ExtResource("2_lt157")
speaker = 1
text = "这里有好多云朵！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_p5s07"]
script = ExtResource("2_lt157")
speaker = 2
text = "而且形状也都不一样......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_jdcqs"]
script = ExtResource("2_lt157")
speaker = 1
text = "让我想起了小时候经常玩的影子游戏，[color=#1B5E20]拿各种奇形怪状的东西拼出奇形怪状的影子[/color]......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_ahl3s"]
script = ExtResource("2_lt157")
speaker = 2
text = "有时会羡慕你们有如此天真的人生时期......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

