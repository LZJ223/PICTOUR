[sub_resource type="Resource" id="Resource_ubige"]
script = ExtResource("2_jnu60")
speaker = 1
text = "再往前走，就要到神奇的森林之城了！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_q12b3"]
script = ExtResource("2_jnu60")
speaker = 2
text = "但是前面是一个很高的悬崖......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_e1vn8"]
script = ExtResource("2_jnu60")
speaker = 1
text = "你可是主角！相信你有办法过去的！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_mv5yj"]
script = ExtResource("2_jnu60")
speaker = 1
text = "悬崖上似乎有什么东西，[color=#1B5E20]小心不要被砸到了哦[/color]！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

