; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PICTOUR"
run/main_scene="uid://hp7gwrwih27g"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Global="*uid://dl63g7i2u2byx"
SignalSystem="*res://System/Signal.gd"
Renderer="*res://System/Renderer.gd"
SceneTransition="*res://System/Scene_Transition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/soil_baker/plugin.cfg", "res://addons/leaf_baker/plugin.cfg", "res://addons/trunk_baker/plugin.cfg", "res://addons/cloud_box_rounder/plugin.cfg")

