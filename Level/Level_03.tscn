[sub_resource type="Resource" id="Resource_s0341"]
script = ExtResource("2_b2uan")
text = "一路上，小机器人遇到了很多阻碍，但也会有愿意帮助他的小小伙伴。
所以，虽然有许多的艰难险阻，但是他都一一克服了......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_203be"]
script = ExtResource("2_b2uan")
speaker = 1
text = "又见面了！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_np0hi"]
script = ExtResource("2_b2uan")
speaker = 1
text = "右边似乎有你的...呃...同伴？"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_dbj7n"]
script = ExtResource("2_b2uan")
speaker = 2
text = "我是最新的型号。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_tylnt"]
script = ExtResource("2_b2uan")
speaker = 1
text = "不然说你是主角呢！我在想，他们虽然看起来不聪明，[color=#1B5E20]但是搬搬东西应该还是很在行的吧[/color]！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_kjhld"]
script = ExtResource("2_b2uan")
speaker = 2
text = "不许这么说他们......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

