[sub_resource type="Resource" id="Resource_wrla2"]
script = ExtResource("2_cav3p")
text = "小机器人爬到了高高的云端，这里谁也不在，只有星星一眨一眨，陪着孤单的他......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_akhyu"]
script = ExtResource("2_cav3p")
speaker = 1
text = "谁说的，这不还有我嘛！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_4u4ni"]
script = ExtResource("2_cav3p")
speaker = 2
text = "月亮......升起来了......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_rm1mo"]
script = ExtResource("2_cav3p")
speaker = 1
text = "是啊，[color=#1B5E20]月光之下，影子都变得淡淡的了[/color]。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_yxdl5"]
script = ExtResource("2_cav3p")
speaker = 1
text = "总有种预感我们要分别了。"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_l0ri5"]
script = ExtResource("2_cav3p")
speaker = 2
text = "在月光下分别也挺好的......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

