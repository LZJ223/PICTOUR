[sub_resource type="Resource" id="Resource_g3ba4"]
script = ExtResource("2_bj315")
text = "不一会，小机器人来到了城市的中心，他将攀上最高的树冠，触碰天上的云朵......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_n35f2"]
script = ExtResource("2_bj315")
speaker = 2
text = "真的需要爬的这么高吗......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_vwd6t"]
script = ExtResource("2_bj315")
speaker = 1
text = "哇，这里真壮观！[color=#1B5E20]到处都是参天大树[/color]！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_5amqd"]
script = ExtResource("2_bj315")
speaker = 1
text = "你说，他们住这么近，[color=#1B5E20]会每天来回串门吗[/color]！"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

[sub_resource type="Resource" id="Resource_wpflu"]
script = ExtResource("2_bj315")
speaker = 2
text = "不知道，他们这个型号应该还没有社交需求吧......"
metadata/_custom_type_script = "uid://ctimfmygmqfa3"

